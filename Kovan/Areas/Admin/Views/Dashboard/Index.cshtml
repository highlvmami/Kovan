@* ADMIN – PANO: istatistik kartları, basit CSS çubuk grafik, son aktiviteler *@
@model DashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
    var max = Math.Max(1, Model.ModuleBars.Max(b => b.Value));
}

@* ===== [PARTIAL VIEW] _PageHeader → sayfa başlığı; veriyi bu sayfa model="..." ile verir (Views/Shared/Partials/_PageHeader.cshtml) ===== *@
<partial name="_PageHeader" model='new PageHeaderViewModel { Title = "Yönetim Paneli", Subtitle = "Kovanın genel durumu.", Icon = "bi-shield-lock", ModuleName = "Yönetim" }' />

<section class="kv-section">
    <div class="container">
        <div class="kv-admin-nav mb-4">
            <a class="active" asp-action="Index"><i class="bi bi-speedometer2"></i> Pano</a>
            <a asp-action="Users"><i class="bi bi-people"></i> Kullanıcılar</a>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-6 col-lg-2"><div class="kv-stat"><i class="bi bi-people"></i><strong>@Model.Stats.UserCount</strong><span>Kullanıcı</span></div></div>
            <div class="col-6 col-lg-2"><div class="kv-stat"><i class="bi bi-shop"></i><strong>@Model.Stats.ActiveListingCount</strong><span>Aktif ilan</span></div></div>
            <div class="col-6 col-lg-2"><div class="kv-stat"><i class="bi bi-calendar-event"></i><strong>@Model.Stats.UpcomingEventCount</strong><span>Etkinlik</span></div></div>
            <div class="col-6 col-lg-2"><div class="kv-stat"><i class="bi bi-chat-dots"></i><strong>@Model.Stats.RoomCount</strong><span>Oda</span></div></div>
            <div class="col-6 col-lg-2"><div class="kv-stat"><i class="bi bi-car-front"></i><strong>@Model.Stats.RideCount</strong><span>Yolculuk</span></div></div>
            <div class="col-6 col-lg-2"><div class="kv-stat danger"><i class="bi bi-flag"></i><strong>@Model.Stats.PendingReportCount</strong><span>Şikâyet</span></div></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="kv-panel h-100">
                    <h2 class="h5 mb-4">Modüllere göre içerik</h2>
                    <div class="kv-bars">
                        @foreach (var b in Model.ModuleBars)
                        {
                            <div class="kv-bar-col">
                                <div class="kv-bar @b.ColorClass" style="height:@(b.Value * 100 / max)%"><span>@b.Value</span></div>
                                <small>@b.Label</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="kv-panel h-100">
                    <h2 class="h5 mb-3">Son aktiviteler</h2>
                    <ul class="kv-timeline">
                        @foreach (var a in Model.RecentActivities)
                        {
                            <li>@a</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
