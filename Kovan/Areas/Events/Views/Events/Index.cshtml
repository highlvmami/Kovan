@* ===== [VIEW] Etkinlik listesi · Controller: EventsController → Index() · Adres: /Events ===== *@
@* EVENTS – ETKİNLİK LİSTESİ: kategori sekmeleri Enum'dan, kartlar Model.Events'ten @foreach ile *@
@model EventIndexViewModel
@{
    ViewData["Title"] = "Etkinlikler";
}

@* ===== [PARTIAL VIEW] _PageHeader → sayfa başlığı; veriyi bu sayfa model="..." ile verir (Views/Shared/Partials/_PageHeader.cshtml) ===== *@
<partial name="_PageHeader" model='new PageHeaderViewModel { Title = "Kampüste Neler Var?", Subtitle = "Kulüp ve bireysel etkinlikler, atölyeler, turnuvalar.", Icon = "bi-calendar-event", ModuleName = "Etkinlikler" }' />

<section class="kv-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="kv-tabs">
                <a class="kv-tab @(Model.SelectedCategory == null ? "active" : "")" asp-action="Index">Tümü</a>
                @* [RAZOR] @foreach → Enum.GetValues<EventCategory>() içindeki her öğe (c) için aşağıdaki HTML tekrar üretilir *@
                @foreach (var c in Enum.GetValues<EventCategory>())
                {
                    <a class="kv-tab @(Model.SelectedCategory == c ? "active" : "")" asp-action="Index" asp-route-category="@c">
                        <i class="bi @c.ToIcon()"></i> @c.ToDisplay()
                    </a>
                }
            </div>
            <div class="d-flex gap-2">
                <a class="btn kv-btn-outline btn-sm" asp-action="Calendar"><i class="bi bi-calendar3"></i> Takvim</a>
                <button class="btn kv-btn-primary btn-sm" disabled title="Faz 3'te aktif olacak"><i class="bi bi-plus-lg"></i> Etkinlik Oluştur</button>
            </div>
        </div>

        @if (Model.Events.Any())
        {
            <div class="row g-4">
                @* [RAZOR] @foreach → Model.Events içindeki her öğe (ev) için aşağıdaki HTML tekrar üretilir *@
                @foreach (var ev in Model.Events)
                {
                    <div class="col-md-6 col-lg-4">
                        @* ===== [PARTIAL VIEW] _EventCard → etkinlik kartı; veriyi bu sayfa model="..." ile verir (Views/Shared/Partials/_EventCard.cshtml) ===== *@
                        <partial name="_EventCard" model="ev" />
                    </div>
                }
            </div>
        }
        else
        {
            @* ===== [PARTIAL VIEW] _EmptyState → boş durum kutusu; veriyi bu sayfa model="..." ile verir (Views/Shared/Partials/_EmptyState.cshtml) ===== *@
            <partial name="_EmptyState" model='new EmptyStateViewModel { Icon = "bi-calendar-x", Title = "Bu kategoride yaklaşan etkinlik yok", Message = "Başka bir kategoriye göz at ya da takvimi incele." }' />
        }
    </div>
</section>
