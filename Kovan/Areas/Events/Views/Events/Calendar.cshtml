@* ===== [VIEW] Etkinlik takvimi · Controller: EventsController → Calendar() · Adres: /Events/Events/Calendar ===== *@
@*
    EVENTS – TAKVİM GÖRÜNÜMÜ
    42 hücrelik (6 hafta) ay ızgarası CalendarViewModel.Build ile hazırlanır,
    burada iç içe @foreach ile çizilir. Mobilde liste görünümüne döner (events.css).
*@
@model CalendarViewModel
@{
    ViewData["Title"] = "Etkinlik Takvimi";
    var dayNames = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
}

@* ===== [PARTIAL VIEW] _PageHeader → sayfa başlığı; veriyi bu sayfa model="..." ile verir (Views/Shared/Partials/_PageHeader.cshtml) ===== *@
<partial name="_PageHeader" model='new PageHeaderViewModel { Title = "Etkinlik Takvimi", Subtitle = "Ay ay tüm kampüs etkinlikleri.", Icon = "bi-calendar3", ModuleName = "Etkinlikler" }' />

<section class="kv-section">
    <div class="container">
        <div class="kv-panel">
            <div class="kv-cal-head">
                <a class="btn kv-btn-outline btn-sm" asp-action="Calendar" asp-route-year="@Model.Prev.Year" asp-route-month="@Model.Prev.Month" aria-label="Önceki ay"><i class="bi bi-chevron-left"></i></a>
                <h2 class="h4 mb-0 text-capitalize">@Model.MonthTitle</h2>
                <a class="btn kv-btn-outline btn-sm" asp-action="Calendar" asp-route-year="@Model.Next.Year" asp-route-month="@Model.Next.Month" aria-label="Sonraki ay"><i class="bi bi-chevron-right"></i></a>
            </div>

            <div class="kv-calendar">
                @* [RAZOR] @foreach → dayNames içindeki her öğe (name) için aşağıdaki HTML tekrar üretilir *@
                @foreach (var name in dayNames)
                {
                    <div class="kv-cal-dayname">@name</div>
                }
                @* [RAZOR] @foreach → Model.Days içindeki her öğe (day) için aşağıdaki HTML tekrar üretilir *@
                @foreach (var day in Model.Days)
                {
                    <div class="kv-cal-day @(day.IsCurrentMonth ? "" : "other") @(day.IsToday ? "today" : "") @(day.Events.Any() ? "has-events" : "")">
                        <span class="kv-cal-num">@day.Date.Day <span class="kv-cal-mobile-date">@day.Date.ToString("MMMM ddd", DisplayHelpers.Tr)</span></span>
                        @* [RAZOR] @foreach → day.Events içindeki her öğe (e) için aşağıdaki HTML tekrar üretilir *@
                        @foreach (var e in day.Events)
                        {
                            <a class="kv-cal-event" asp-action="Details" asp-route-id="@e.Id" title="@e.Title">
                                <i class="bi @e.Icon"></i> <span>@e.Time</span> @e.Title
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="text-center mt-3">
            <a class="kv-link" asp-action="Index"><i class="bi bi-grid"></i> Kart görünümüne dön</a>
        </div>
    </div>
</section>
