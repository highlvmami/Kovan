@* ===== [VIEW] Giriş formu · Controller: AccountController → Login() · Adres: /Account/Login ===== *@
@* GİRİŞ SAYFASI – Tag Helper'lar (asp-for, asp-validation-for) ile form *@
@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
@section Styles {
    <link rel="stylesheet" href="~/css/modules/account.css" asp-append-version="true" />
}

<section class="kv-auth">
    <div class="container">
        <div class="kv-auth-card">
            <div class="kv-auth-side">
                <img src="~/img/logo.svg" alt="" width="64" height="64" />
                <h2>Kovana tekrar hoş geldin!</h2>
                <p>Öğrenci e-postanla giriş yap, kaldığın yerden devam et.</p>
                <ul class="kv-check-list kv-check-list-light">
                    <li>Ödünç ver, sat, açık artırmaya çık</li>
                    <li>Etkinliklere tek tıkla kaydol</li>
                    <li>Güven puanını yükselt</li>
                </ul>
            </div>
            <div class="kv-auth-form">
                <h1>Giriş Yap</h1>
                <form asp-action="Login" method="post" novalidate>
                    @* Model hatalarının özeti *@
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="kv-input-icon">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" class="form-control" placeholder="ad@ogr.cbu.edu.tr" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="kv-input-icon">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password" class="form-control" placeholder="••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a href="#" class="kv-link small">Şifremi unuttum</a>
                    </div>

                    <button type="submit" class="btn kv-btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</button>
                </form>
                <p class="text-center mt-4 mb-0 small">
                    Hesabın yok mu? <a class="kv-link" asp-action="Register">Kayıt ol</a>
                </p>
            </div>
        </div>
    </div>
</section>
