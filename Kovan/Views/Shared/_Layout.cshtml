@*
    ============================================================
    KOVAN – ORTAK LAYOUT
    Tüm sayfalar (ana uygulama + tüm Area'lar) bu şablonu kullanır.
    - Navbar (modül linkleri + bildirim zili ViewComponent'i)
    - TempData mesajları
    - @RenderBody(): sayfanın kendi içeriği buraya gelir
    - Footer
    ============================================================
*@
@inject Kovan.Core.Interfaces.IUserService UserService
@{
    // Navbar avatarı: profil düzenlenince baş harfler de değişir.
    var currentUser = await UserService.GetCurrentUserAsync();

    // Area'ların _ViewStart dosyası ViewData["Module"] değerini doldurur (ör. "market").
    var module = ViewData["Module"] as string;
    var title = ViewData["Title"] as string;

    // Menüde aktif linki işaretlemek için küçük yardımcı fonksiyon
    string Active(string name) => module == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "Kovan" : $"{title} · Kovan")</title>
    <meta name="description" content="Kovan – öğrenciler için modüler kampüs platformu" />
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />

    @* Google Fonts: Poppins *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    @* Bootstrap 5 + Bootstrap Icons (CDN) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* Kovan teması (renkler, petek motifleri, kartlar) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Modüle özel CSS: Area içindeysek otomatik yüklenir *@
    @if (!string.IsNullOrEmpty(module))
    {
        <link rel="stylesheet" href="~/css/modules/@(module).css" asp-append-version="true" />
    }

    @* Sayfanın kendine özel ek CSS'i varsa *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(string.IsNullOrEmpty(module) ? "module-home" : $"module-{module}")">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg kv-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand kv-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.svg" alt="" width="34" height="34" />
                <span>Kovan</span>
            </a>

            <div class="d-flex align-items-center gap-2 order-lg-last">
                @* ===== [VIEW COMPONENT] NotificationBell → bildirim zili; veriyi INotificationService'ten kendisi çeker (ViewComponents/NotificationBellViewComponent.cs) ===== *@
                @await Component.InvokeAsync("NotificationBell")

                <div class="dropdown">
                    <button class="btn kv-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Hesap menüsü">
                        @* Faz 2: baş harfler User.Identity üzerinden gelecek *@
                        <span class="kv-avatar kv-avatar-sm">@currentUser.Initials</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end kv-dropdown">
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Profilim</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Edit"><i class="bi bi-gear"></i> Profili Düzenle</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i> Kayıt Ol</a></li>
                    </ul>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#kvNav"
                        aria-controls="kvNav" aria-expanded="false" aria-label="Menüyü aç">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="kvNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @Active("market")" asp-area="Market" asp-controller="Listings" asp-action="Index"><i class="bi bi-shop"></i> Market</a></li>
                    <li class="nav-item"><a class="nav-link @Active("events")" asp-area="Events" asp-controller="Events" asp-action="Index"><i class="bi bi-calendar-event"></i> Etkinlikler</a></li>
                    <li class="nav-item"><a class="nav-link @Active("topics")" asp-area="Topics" asp-controller="Rooms" asp-action="Index"><i class="bi bi-chat-dots"></i> Konular</a></li>
                    <li class="nav-item"><a class="nav-link @Active("carpool")" asp-area="Carpool" asp-controller="Rides" asp-action="Index"><i class="bi bi-car-front"></i> Yolculuk</a></li>
                    <li class="nav-item"><a class="nav-link @Active("admin")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-shield-lock"></i> Yönetim</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ================= SAYFA İÇERİĞİ ================= -->
    <main class="kv-main">
        <div class="container">
            @* Controller'dan TempData ile gönderilen bilgi mesajları *@
            @if (TempData["Info"] is string info)
            {
                <div class="alert kv-alert alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-info-circle-fill"></i> @info
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="kv-footer">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <div class="kv-brand kv-brand-light">
                        <img src="~/img/logo.svg" alt="" width="30" height="30" />
                        <span>Kovan</span>
                    </div>
                    <p class="mt-2 mb-0 small">Öğrenciler arı, modüller petek gözü. Hepsi tek kovanda. 🐝</p>
                </div>
                <div class="col-md-7">
                    <ul class="kv-footer-links">
                        <li><a asp-area="Market" asp-controller="Listings" asp-action="Index">Market</a></li>
                        <li><a asp-area="Events" asp-controller="Events" asp-action="Index">Etkinlikler</a></li>
                        <li><a asp-area="Topics" asp-controller="Rooms" asp-action="Index">Konular</a></li>
                        <li><a asp-area="Carpool" asp-controller="Rides" asp-action="Index">Yolculuk</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="About">Hakkında</a></li>
                    </ul>
                </div>
            </div>
            <hr />
            <p class="small mb-0 text-center">© @DateTime.Now.Year Kovan · Manisa Celal Bayar Üniversitesi · YZM 3215 İleri Web Programlama</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
