@*
    PROFİL DÜZENLE
    Form elemanları HtmlHelper'larla üretilir (Html.BeginForm, Html.TextBoxFor,
    Html.DropDownListFor, Html.TextAreaFor...). Kaydedilen bilgiler Profil sayfasında,
    navbar avatarında ve ilan kartlarındaki satıcı adında görünür.
*@
@model ProfileEditViewModel
@{
    ViewData["Title"] = "Profili Düzenle";
}
@section Styles {
    <link rel="stylesheet" href="~/css/modules/profile.css" asp-append-version="true" />
}

<partial name="_PageHeader" model='new PageHeaderViewModel { Title = "Profili Düzenle", Subtitle = "Bilgilerin tüm modüllerde ortak kullanılır.", Icon = "bi-person-gear", ModuleName = "Profil" }' />

<section class="kv-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                @using (Html.BeginForm("Edit", "Profile", new { area = "" }, FormMethod.Post, false, new { @class = "kv-panel", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="kv-avatar kv-avatar-lg"><i class="bi bi-camera"></i></span>
                        <div>
                            <strong>Profil fotoğrafı</strong>
                            <small class="d-block kv-muted">Fotoğraf yükleme Faz 3'te eklenecek.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-8">
                            @Html.LabelFor(m => m.Department, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Department, new SelectList(RegisterViewModel.Departments), new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-sm-4">
                            @Html.LabelFor(m => m.Grade, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Grade, new { @class = "form-control", type = "number", min = "1", max = "6" })
                            @Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="mb-4">
                        @Html.LabelFor(m => m.Bio, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Bio, 3, 0, new { @class = "form-control", placeholder = "Kendinden kısaca bahset...", maxlength = "200" })
                        @Html.ValidationMessageFor(m => m.Bio, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        @Html.ActionLink("Vazgeç", "Index", "Profile", new { area = "" }, new { @class = "btn kv-btn-outline" })
                        <button type="submit" class="btn kv-btn-primary"><i class="bi bi-check2"></i> Kaydet</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
